rules_version = '2';

// ==========================================================================
// قواعد أمان Firestore لمشروع "بوابة رواق"
// ==========================================================================
// ⚠️ تنبيه هام يجب قراءته قبل التطبيق:
// هذا المشروع لا يستخدم Firebase Authentication، بل نظام دخول مخصص (كلمة مرور
// مُجزّأة + رمز جلسة يُخزَّن في localStorage). لذلك request.auth هنا دائماً null،
// ولا يمكن لأي قاعدة تمييز "هذا المستخدم" عن غيره.
// بالإضافة لذلك، كل مجموعة بيانات (users, requests, adminChats, directChats...)
// هي وثيقة واحدة تحوي مصفوفة list كاملة لجميع المستخدمين/المحادثات معاً.
// نتيجة ذلك: هذه القواعد توفّر "حماية عامة" (منع أي وصول من خارج تطبيقك،
// والتحقق من صحة شكل البيانات المكتوبة) — لكنها لا تستطيع، ولا يمكن لأي قواعد
// أن تستطيع، منع عضو مسجّل من قراءة بيانات/محادثات عضو آخر طالما البنية الحالية
// (وثيقة واحدة بمصفوفة list) قائمة، ولا يوجد Firebase Authentication حقيقي.
// لتحقيق خصوصية فعلية بين الأعضاء (خصوصاً في المحادثات) يلزم:
//   1) اعتماد Firebase Authentication حقيقي (Custom Tokens تُمنح بعد التحقق من
//      كلمة المرور عبر Cloud Function)، و
//   2) إعادة هيكلة البيانات الحساسة (خصوصاً المحادثات) إلى وثائق فرعية منفصلة
//      لكل محادثة/رسالة بدل مصفوفة list واحدة.
// راجع القسم الثاني في الرسالة المرافقة لهذا الملف لمزيد من التفاصيل والخطوات.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // منع أي وصول لأي مسار غير معرّف صراحة أدناه (Deny by Default)
    match /{document=**} {
      allow read, write: if false;
    }

    match /appData/{docId} {

      // منع حذف الوثيقة بالكامل نهائياً من طرف العميل (حتى لا يُفرّغ أحد قاعدة
      // البيانات بالكامل عبر استدعاء مباشر لواجهة Firestore). الحذف الحقيقي
      // للسجلات يتم داخل التطبيق عبر إعادة كتابة "list" بدون العنصر المحذوف،
      // وهذا يُعامَل كـ update وليس delete.
      allow delete: if false;

      // السماح بالقراءة والكتابة فقط للوثائق السبع المستخدمة فعلياً في التطبيق،
      // مع تحقق أساسي من شكل البيانات (وجود حقل list كمصفوفة) لمنع كتابة بيانات
      // عشوائية أو تخريبية عبر استدعاء مباشر لواجهة Firestore خارج التطبيق.
      allow read: if docId in [
        'users', 'requests', 'passwordRequests', 'reports', 'cutoffs',
        'adminChats', 'directChats'
      ];

      allow create, update: if docId in [
        'users', 'requests', 'passwordRequests', 'reports', 'cutoffs',
        'adminChats', 'directChats'
      ]
      && request.resource.data.keys().hasOnly(['list'])
      && request.resource.data.list is list
      // حد أقصى تقريبي لعدد العناصر لكل وثيقة، لتقليل أثر أي إساءة استخدام أو
      // محاولة إغراق الوثيقة (Firestore يفرض أصلاً حد 1MB لكل وثيقة، وهذا تحقق إضافي)
      && request.resource.data.list.size() < 5000;
    }
  }
}
